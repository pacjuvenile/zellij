////////////////////
// options
////////////////////
// 资源目录
// 资源目录默认在config.kdl同级目录
// layout_dir	"/home/pacjuvenile/.config/zellij/layouts"
// theme_dir	"/home/pacjuvenile/.config//zellij/themes"

// 启动选项
show_startup_tips	false
show_release_notes	false
default_mode	"normal"	// 默认启动模式会透传未绑定按键

// shell选项
on_force_close	"detach"
default_shell	"zsh"
// default_cwd	""	// 默认工作路径继承父进程
// session_name	"work"	// 默认使用随机会话名	
attach_to_session	false

// UI选项
theme	"dracula"
default_layout	"custom_layout"
pane_frames	true
simplified_ui	false
visual_bell	true
styled_underlines	true

// 鼠标选项
mouse_mode	false
advanced_mouse_actions	false
mouse_hover_effects	false
copy_on_select false

// 会话选项
auto_layout	true
stacked_resize	true
scroll_buffer_size 10000
osc8_hyperlinks	true
// copy_command "xclip -selection clipboard"	// 默认走OSC 52路线
copy_clipboard	"system"	// 仅OSC 52时生效
scrollback_editor	"nvim"
mirror_session	false
support_kitty_keyboard_protocol false
session_serialization	true
serialization_interval 60
serialize_pane_viewport	false
// scrollback_lines_to_serialize	10000
disable_session_metadata	false

// Web选项
web_server	false

////////////////////
// plugins
////////////////////
plugins {
	zellij-wayfinder location="file:zellij-wayfinder.wasm"
}

load_plugins {
	// "file:/path/to/my-plugin.wasm"
	// "https://example.com/my-plugin.wasm"
}

////////////////////
// keybinds
////////////////////
keybinds clear-defaults=true {
	normal {
		// tmux mode
		bind "Ctrl s" { SwitchToMode "tmux"; }
	}
	tmux {
		bind "Esc" { ScrollToBottom; SwitchToMode "Normal"; }	

		// session:lifecycle
		bind "d" { Detach; }
		bind "D" { Quit; }
		// session: state
		// session: navigation
		bind "l" { 
			LaunchOrFocusPlugin "zellij-wayfinder" {
				floating true
				move_to_focused_tab true
			}
			SwitchToMode "normal"
		}
		// session: move

		// tab: lifecycle
		bind "t" { NewTab; SwitchToMode "Normal"; }
		bind "X" { CloseTab; SwitchToMode "Normal"; }
		// tab: state
		bind "R" { SwitchToMode "RenameTab"; TabNameInput 0; }
  	bind "*" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
		// tab: navigation
		bind "n" { GoToNextTab; SwitchToMode "Normal"; }
		bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
		bind "1" { GoToTab 1; SwitchToMode "Normal"; }
		bind "2" { GoToTab 2; SwitchToMode "Normal"; }
		bind "3" { GoToTab 3; SwitchToMode "Normal"; }
		bind "4" { GoToTab 4; SwitchToMode "Normal"; }
		bind "5" { GoToTab 5; SwitchToMode "Normal"; }
		bind "6" { GoToTab 6; SwitchToMode "Normal"; }
		bind "7" { GoToTab 7; SwitchToMode "Normal"; }
		bind "8" { GoToTab 8; SwitchToMode "Normal"; }
		bind "9" { GoToTab 9; SwitchToMode "Normal"; }
		// tab:move
		bind "[" { MoveTab "Left"; SwitchToMode "Normal"; }
		bind "]" { MoveTab "Right"; SwitchToMode "Normal"; }
		
		// pane: layout 
		bind "|" { NewPane "Right"; SwitchToMode "Normal"; }
		bind "_" { NewPane "Down"; SwitchToMode "Normal"; }
		bind "s" { NewPane "stacked"; SwitchToMode "Normal"; }
		bind "x" { CloseFocus; SwitchToMode "Normal"; }
		// pane: state
		bind "r" { SwitchToMode "RenamePane"; PaneNameInput 0; }
		bind "f" { ToggleFloatingPanes; SwitchToMode "Normal"; }
		bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
		// pane: scroll
		bind "j" { ScrollDown; }
		bind "k" { ScrollUp; }
		bind "Ctrl d" { HalfPageScrollDown; }
		bind "Ctrl u" { HalfPageScrollUp; }
		bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
		bind "e" { EditScrollback; SwitchToMode "Normal"; }
		// pane: focus
		bind "Ctrl h" { MoveFocus "Left"; SwitchToMode "Normal"; }
		bind "Ctrl j" { MoveFocus "Down"; SwitchToMode "Normal"; }
		bind "Ctrl k" { MoveFocus "Up"; SwitchToMode "Normal"; }
		bind "Ctrl l" { MoveFocus "Right"; SwitchToMode "Normal"; }
		// pane: move
		bind "left" { MovePane "Left"; }
		bind "down" { MovePane "Down"; }
		bind "up" { MovePane "Up"; }
		bind "right" { MovePane "Right"; }
		// pane: resize
		bind "<" { Resize "Increase Left"; }
		bind ">" { Resize "Increase Right"; }
		bind "+" { Resize "Increase Down"; }
		bind "-" { Resize "Increase Up"; }
	}
	entersearch {
		bind "Esc" { SwitchToMode "tmux"; }
		bind "Enter" { SwitchToMode "Search"; SearchToggleOption "Wrap"; }
	}
	search {
		bind "Esc" { SwitchToMode "tmux"; }
		bind "n" { Search "down"; }
		bind "N" { Search "up"; }
		bind "c" { SearchToggleOption "CaseSensitivity"; }
		bind "o" { SearchToggleOption "WholeWord"; }
	}
	renametab {
		bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
		bind "Enter" { SwitchToMode "Normal"; }
	}
	renamepane {
		bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
		bind "Enter" { SwitchToMode "Normal"; }
	}
}
